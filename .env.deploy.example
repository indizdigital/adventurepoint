# Copy to .env.deploy and fill in. .env.deploy is never uploaded or committed.

# SSH target (user@host) and port
SSH_TARGET=user@example.ch
SSH_PORT=22
# Optional extra ssh options, e.g. a specific key: -i ~/.ssh/id_ed25519
SSH_OPTS=

# Absolute path of the web root on the server (where wp-config.php will live)
REMOTE_PATH=/home/user/public_html

# Public URL of the site (no trailing slash)
SITE_URL=https://www.adventurepoint.ch
SITE_TITLE=AdventurePoint

# Database (create it in your hosting panel first)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost

# First admin account (leave password empty to generate a strong one)
ADMIN_USER=adventurepoint-admin
ADMIN_EMAIL=info@adventurepoint.ch
ADMIN_PASSWORD=

# Where reservation notifications go
NOTIFY_EMAIL=info@adventurepoint.ch

# PHP / WP-CLI on the server (leave as-is unless your host needs e.g. /usr/bin/php8.3)
REMOTE_PHP=php
